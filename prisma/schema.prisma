generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                   Int              @id @default(autoincrement())
  nome                 String
  email                String           @unique
  senha                String
  bio                  String?
  fotoUrl              String?
  tipoUsuario          String           @default("discente")
  aceitouTermos        Boolean          @default(false)
  notificacoesAtivas   Boolean          @default(true)
  notificarSistema     Boolean          @default(true)
  notificarQuestionarios Boolean        @default(true)
  isAdmin              Boolean          @default(false)
  criadoEm             DateTime         @default(now())
  sessoes              Sessao[]
  inscricoes           InscricaoPush[]
  notificacoes         Notificacao[]
  medias               Media[]
  questionarios        Questionario[]
  respostasQuestionario Resposta[]
}

model Sessao {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  criadoEm  DateTime @default(now())
}

model InscricaoPush {
  id           Int      @id @default(autoincrement())
  endpoint     String
  p256dh       String
  auth         String
  usuarioId    Int
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm     DateTime @default(now())

  @@unique([endpoint])
}

model Notificacao {
  id         Int      @id @default(autoincrement())
  titulo     String
  mensagem   String
  url        String?
  lida       Boolean  @default(false)
  criadaEm   DateTime @default(now())
  enviadaEm  DateTime?
  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Media {
  id          String   @id @default(cuid())
  ownerId     Int
  filename    String
  originalName String
  mimeType    String
  size        Int
  storageKey  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       Usuario  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Questionario {
  id           Int         @id @default(autoincrement())
  titulo       String
  descricao    String?
  status       String      @default("rascunho")
  anonimo      Boolean     @default(true)
  resultadosVisiveis Boolean @default(true)
  corTema      String?     @default("#6366f1")
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt
  encerraEm    DateTime?
  usuariosEsperados Int?
  autorId      Int
  autor        Usuario     @relation(fields: [autorId], references: [id], onDelete: Cascade)
  perguntas    Pergunta[]
  respostas    Resposta[]

  @@index([autorId])
  @@index([status])
}

model Pergunta {
  id             Int           @id @default(autoincrement())
  texto          String
  tipo           String
  obrigatoria    Boolean       @default(false)
  ordem          Int
  configEscala   Json?
  condicoes      Json?
  questionarioId Int
  questionario   Questionario  @relation(fields: [questionarioId], references: [id], onDelete: Cascade)
  opcoes         Opcao[]
  valores        ValorResposta[]

  @@index([questionarioId])
}

model Opcao {
  id         Int             @id @default(autoincrement())
  texto      String
  ordem      Int
  correta    Boolean         @default(false)
  perguntaId Int
  pergunta   Pergunta        @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  valores    ValorResposta[]

  @@index([perguntaId])
}

model Resposta {
  id             Int            @id @default(autoincrement())
  usuarioId      Int
  usuario        Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  questionarioId Int
  questionario   Questionario   @relation(fields: [questionarioId], references: [id], onDelete: Cascade)
  nomeAnonimo    String?
  syncId         String?        @unique
  criadoEm       DateTime       @default(now())
  valores        ValorResposta[]

  @@unique([usuarioId, questionarioId])
  @@index([questionarioId])
}

model ValorResposta {
  id            Int      @id @default(autoincrement())
  respostaId    Int
  resposta      Resposta @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  perguntaId    Int
  pergunta      Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  texto         String?
  opcaoId       Int?
  opcao         Opcao?   @relation(fields: [opcaoId], references: [id])
  valorNumerico Int?

  @@index([respostaId])
  @@index([perguntaId])
}